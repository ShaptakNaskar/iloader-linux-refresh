+fn inventory_bundles(
+    profiles: &[profile::PhoneProfile],
+    team: &str,
+    inventory: Result<std::collections::HashSet<String>, String>,
+) -> Result<Vec<String>, String> {
+    let installed = require_installed_apps(inventory)?;
+    let mine = profile::latest_by_bundle(profiles.iter().filter(|p| p.team_id.as_deref() == Some(team)));
+    let bundles: Vec<&str> = mine.iter().filter_map(|p| p.bundle_id.as_deref()).collect();
+    let mut hosts = std::collections::BTreeSet::new();
+    for bundle in &bundles {
+        let root = profile::group_root(bundle, &bundles, team);
+        if installed.contains(root) || installed.contains(profile::profile_app_id(root, team)) {
+            hosts.insert(root.to_string());
+        }
+    }
+    Ok(hosts.into_iter().collect())
+}
+
